{
  "name": "stackcart-events",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
